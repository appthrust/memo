# syntax=docker/dockerfile:1

FROM --platform=$BUILDPLATFORM docker.io/golang:1.27.3 AS server-builder
WORKDIR /workspace
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY cmd/authz-probe ./cmd/authz-probe
RUN --mount=type=cache,target=/root/.cache/go-build --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w -X main.releaseVersion=${VERSION}" -o /out/authz-probe ./cmd/authz-probe

FROM gcr.io/distroless/static:nonroot
COPY --from=server-builder /out/authz-probe /authz-probe
USER 65532
EXPOSE 8080
ENTRYPOINT ["/authz-probe"]
